# Configuración del servicio de pagos

# Puerto del servidor
PORT=3004

# MongoDB URI (opcional - para historial de pagos)
MONGODB_URI=mongodb://localhost:27017/huertabeja_pagos

# Credenciales de Mercado Pago
# Obtén tus credenciales en: https://www.mercadopago.cl/developers/panel/credentials
MERCADOPAGO_ACCESS_TOKEN=tu_access_token_aqui

# URL del webhook (opcional - para notificaciones)
# WEBHOOK_URL=https://tu-dominio.com/api/pagos/webhook
